---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getDictionary, localizedPath, parseLocalizedUrl } from '@/i18n/config';

const { lang, path } = parseLocalizedUrl(Astro.url.pathname);
const dict = getDictionary(lang);
const nf = dict.notFound;
---

<BaseLayout lang={lang} path={path} title={nf.title} noindex>
  <section class="container not-found">
    <span class="mark">404</span>
    <h1>{nf.title}</h1>
    <p>{nf.body}</p>
    <div class="actions">
      <a class="btn" href={localizedPath(lang, '/')}>{nf.cta}</a>
      <a class="text-link" href={localizedPath(lang, '/catalog')}>{nf.cta2}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: 100px 120px;
    text-align: center;
  }

  .mark {
    display: block;
    font-family: 'Tangerine', 'Cormorant Garamond', serif;
    font-weight: 700;
    font-size: 140px;
    line-height: 1;
    color: var(--color-accent-dark);
    margin-bottom: 4px;
  }

  .not-found h1 {
    margin: 0 0 12px;
    font-size: 24px;
  }

  .not-found p {
    color: var(--color-text-muted);
    max-width: 420px;
    margin: 0 auto 32px;
  }

  .actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .text-link {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 16px;
    color: var(--color-text-muted);
  }
</style>
