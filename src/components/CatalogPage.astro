---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCard from '@/components/ProductCard.astro';
import { getDictionary, type Locale } from '@/i18n/config';
import { fetchCatalogData } from '@/lib/catalog';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = getDictionary(lang);
const { categories, products } = await fetchCatalogData();
---

<BaseLayout lang={lang} path="/catalog" title={dict.nav.catalog}>
  <section class="container catalog">
    <h1>{dict.nav.catalog}</h1>

    <div class="catalog-toolbar">
      <label class="search-control">
        <span class="search-icon" aria-hidden="true">⌕</span>
        <input
          type="search"
          id="catalog-search"
          placeholder={dict.common.searchPlaceholder}
          aria-label={dict.common.searchPlaceholder}
        />
      </label>

      <div class="category-pills" role="group" aria-label={dict.common.allCategories}>
        <button type="button" class="category-pill active" data-slug="all">
          {dict.common.allCategories}
        </button>
        {
          categories.map((c) => (
            <button type="button" class="category-pill" data-slug={c.slug}>
              {lang === 'ua' ? c.name_ua : c.name_ru}
            </button>
          ))
        }
      </div>

      <label class="sort-control">
        {dict.common.sortBy}
        <select id="sort-select">
          <option value="newest">{dict.common.sortNewest}</option>
          <option value="price_asc">{dict.common.sortPriceAsc}</option>
          <option value="price_desc">{dict.common.sortPriceDesc}</option>
        </select>
      </label>
    </div>

    <div class="filter-row">
      <label class="price-control">
        {dict.common.priceFrom}
        <input type="number" id="price-min" min="0" step="1" inputmode="numeric" />
        {dict.common.priceTo}
        <input type="number" id="price-max" min="0" step="1" inputmode="numeric" />
        <span class="price-currency">₴</span>
      </label>

      <label class="checkbox-control">
        <input type="checkbox" id="in-stock-only" />
        {dict.common.inStockOnly}
      </label>
    </div>

    {
      products.length === 0 ? (
        <p class="empty">{dict.common.noProducts}</p>
      ) : (
        <>
          <p class="empty" id="catalog-no-search-results" hidden>
            {dict.common.noSearchResults}
          </p>
          <div class="catalog-grid">
            {products.map((p) => (
              <ProductCard lang={lang} product={p} />
            ))}
          </div>
        </>
      )
    }
  </section>
</BaseLayout>

<style>
  .catalog {
    padding-block: 40px 80px;
  }

  .catalog h1 {
    margin-bottom: 24px;
  }

  .filter-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 24px;
  }

  .price-control {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .price-control input {
    width: 72px;
    padding: 6px 8px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 14px;
    font-family: inherit;
  }

  .price-currency {
    color: var(--color-text-muted);
  }

  .checkbox-control {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .checkbox-control input {
    width: 16px;
    height: 16px;
    accent-color: var(--color-accent-dark);
    cursor: pointer;
  }

  .catalog-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 28px;
  }

  .search-control {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1 1 220px;
    max-width: 280px;
    padding: 6px 4px 8px;
    border-bottom: 1px solid var(--color-border);
  }

  .search-icon {
    color: var(--color-text-muted);
    font-size: 15px;
  }

  .search-control input {
    flex: 1;
    border: none;
    background: none;
    outline: none;
    font-size: 14px;
    font-family: inherit;
    color: var(--color-text);
  }

  .search-control input::placeholder {
    color: var(--color-text-muted);
  }

  .category-pills {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 18px;
  }

  .category-pill {
    background: none;
    border: none;
    padding: 0 0 3px;
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text-muted);
    position: relative;
  }

  .category-pill::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 1px;
    background: var(--color-accent-dark);
    transition: right 0.25s ease;
  }

  .category-pill:hover {
    color: var(--color-text);
  }

  .category-pill.active {
    color: var(--color-accent-dark);
  }

  .category-pill.active::after {
    right: 0;
  }

  .sort-control {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .sort-control select {
    padding: 4px 2px 6px;
    border: none;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
    background: none;
    color: var(--color-text);
    font-size: 14px;
    text-transform: none;
    letter-spacing: normal;
    font-weight: 400;
  }

  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
  }

  .catalog-grid[hidden] {
    display: none;
  }

  .empty {
    color: var(--color-text-muted);
    padding-block: 40px;
    text-align: center;
  }
</style>

<script>
  const grid = document.querySelector<HTMLDivElement>('.catalog-grid');
  const pills = document.querySelectorAll<HTMLButtonElement>('.category-pill');
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;
  const searchInput = document.getElementById('catalog-search') as HTMLInputElement | null;
  const noResultsEl = document.getElementById('catalog-no-search-results');
  const priceMinInput = document.getElementById('price-min') as HTMLInputElement | null;
  const priceMaxInput = document.getElementById('price-max') as HTMLInputElement | null;
  const inStockOnlyInput = document.getElementById('in-stock-only') as HTMLInputElement | null;

  if (grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLAnchorElement>('.product-card'));
    const params = new URLSearchParams(location.search);
    let activeCategory = params.get('category') || 'all';
    let activeSort = params.get('sort') || 'newest';
    let activeQuery = (params.get('q') || '').trim().toLowerCase();
    let priceMin = params.get('price_min') || '';
    let priceMax = params.get('price_max') || '';
    let inStockOnly = params.get('in_stock') === '1';

    function applyFilterSort() {
      let visibleCount = 0;
      const minVal = priceMin !== '' ? Number(priceMin) : null;
      const maxVal = priceMax !== '' ? Number(priceMax) : null;

      cards.forEach((card) => {
        const categoryMatch = activeCategory === 'all' || card.dataset.categorySlug === activeCategory;
        const searchMatch = !activeQuery || (card.dataset.name || '').includes(activeQuery);
        const price = Number(card.dataset.price);
        const priceMatch = (minVal === null || price >= minVal) && (maxVal === null || price <= maxVal);
        const stockMatch = !inStockOnly || card.dataset.inStock === '1';
        const match = categoryMatch && searchMatch && priceMatch && stockMatch;
        card.style.display = match ? '' : 'none';
        if (match) visibleCount++;
      });

      if (noResultsEl) noResultsEl.toggleAttribute('hidden', visibleCount !== 0);
      grid?.toggleAttribute('hidden', visibleCount === 0);

      const sorted = [...cards].sort((a, b) => {
        if (activeSort === 'price_asc') return Number(a.dataset.price) - Number(b.dataset.price);
        if (activeSort === 'price_desc') return Number(b.dataset.price) - Number(a.dataset.price);
        return Number(b.dataset.created) - Number(a.dataset.created);
      });
      sorted.forEach((card) => grid?.appendChild(card));

      pills.forEach((p) => p.classList.toggle('active', p.dataset.slug === activeCategory));

      const newParams = new URLSearchParams();
      if (activeCategory !== 'all') newParams.set('category', activeCategory);
      if (activeSort !== 'newest') newParams.set('sort', activeSort);
      if (activeQuery) newParams.set('q', activeQuery);
      if (priceMin !== '') newParams.set('price_min', priceMin);
      if (priceMax !== '') newParams.set('price_max', priceMax);
      if (inStockOnly) newParams.set('in_stock', '1');
      const qs = newParams.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    }

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        activeCategory = pill.dataset.slug || 'all';
        applyFilterSort();
      });
    });

    if (sortSelect) {
      sortSelect.value = activeSort;
      sortSelect.addEventListener('change', () => {
        activeSort = sortSelect.value;
        applyFilterSort();
      });
    }

    if (searchInput) {
      searchInput.value = activeQuery;
      let debounceTimer: number | undefined;
      searchInput.addEventListener('input', () => {
        window.clearTimeout(debounceTimer);
        debounceTimer = window.setTimeout(() => {
          activeQuery = searchInput.value.trim().toLowerCase();
          applyFilterSort();
        }, 150);
      });
    }

    if (priceMinInput) {
      priceMinInput.value = priceMin;
      let priceDebounce: number | undefined;
      priceMinInput.addEventListener('input', () => {
        window.clearTimeout(priceDebounce);
        priceDebounce = window.setTimeout(() => {
          priceMin = priceMinInput.value.trim();
          applyFilterSort();
        }, 200);
      });
    }

    if (priceMaxInput) {
      priceMaxInput.value = priceMax;
      let priceDebounce: number | undefined;
      priceMaxInput.addEventListener('input', () => {
        window.clearTimeout(priceDebounce);
        priceDebounce = window.setTimeout(() => {
          priceMax = priceMaxInput.value.trim();
          applyFilterSort();
        }, 200);
      });
    }

    if (inStockOnlyInput) {
      inStockOnlyInput.checked = inStockOnly;
      inStockOnlyInput.addEventListener('change', () => {
        inStockOnly = inStockOnlyInput.checked;
        applyFilterSort();
      });
    }

    applyFilterSort();
  }
</script>
