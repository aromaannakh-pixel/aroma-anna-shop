---
import { localizedPath, getDictionary, type Locale } from '@/i18n/config';
import { formatPrice } from '@/lib/format';
import type { ProductView } from '@/lib/catalog';

interface Props {
  lang: Locale;
  product: ProductView;
}

const { lang, product } = Astro.props;
const dict = getDictionary(lang);
const name = lang === 'ua' ? product.name_ua : product.name_ru;
const shortDesc = lang === 'ua' ? product.short_desc_ua : product.short_desc_ru;
const image = product.images?.[0];
const createdTs = new Date(product.created_at).getTime();
---

<a
  class="product-card"
  data-category-slug={product.categorySlug ?? ''}
  data-price={product.effectivePrice}
  data-created={createdTs}
  data-in-stock={product.in_stock ? '1' : '0'}
  data-name={`${product.name_ua} ${product.name_ru}`.toLowerCase()}
  href={localizedPath(lang, `/product/${product.slug}`)}
>
  <div class="thumb">
    {
      image ? (
        <img src={image} alt={name} loading="lazy" />
      ) : (
        <div class="thumb-placeholder" aria-hidden="true">🌿</div>
      )
    }
    {!product.in_stock && <span class="badge badge-out card-badge">{dict.common.outOfStock}</span>}
    {product.in_stock && product.isOnSale && <span class="badge badge-sale card-badge">{dict.common.sale}</span>}
  </div>

  <h3 class="name">{name}</h3>
  {shortDesc && <p class="desc">{shortDesc}</p>}

  <div class="price-row">
    {
      product.isOnSale ? (
        <>
          <span class="price-old">{formatPrice(Number(product.price), lang)}</span>
          <span class="price-sale">{formatPrice(product.effectivePrice, lang)}</span>
        </>
      ) : (
        <span class="price">{formatPrice(product.effectivePrice, lang)}</span>
      )
    }
  </div>
</a>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    color: var(--color-text);
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }

  .product-card:hover {
    text-decoration: none;
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .thumb {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--color-accent-soft);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumb-placeholder {
    font-size: 40px;
  }

  .card-badge {
    position: absolute;
    top: 10px;
    left: 10px;
  }

  .name {
    font-size: 16px;
    margin: 12px 14px 4px;
  }

  .desc {
    font-size: 13px;
    color: var(--color-text-muted);
    margin: 0 14px 10px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .price-row {
    margin: auto 14px 14px;
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .price,
  .price-sale {
    font-weight: 700;
    font-size: 16px;
    color: var(--color-text);
  }

  .price-sale {
    color: var(--color-sale);
  }

  .price-old {
    font-size: 13px;
    color: var(--color-text-muted);
    text-decoration: line-through;
  }
</style>
