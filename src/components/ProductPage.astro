---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getDictionary, type Locale } from '@/i18n/config';
import { formatPrice } from '@/lib/format';
import type { ProductView } from '@/lib/catalog';

interface Props {
  lang: Locale;
  product: ProductView;
}

const { lang, product } = Astro.props;
const dict = getDictionary(lang);

const name = lang === 'ua' ? product.name_ua : product.name_ru;
const description = (lang === 'ua' ? product.description_ua : product.description_ru) ?? '';
const shortDesc = lang === 'ua' ? product.short_desc_ua : product.short_desc_ru;
const seoTitle = (lang === 'ua' ? product.seo_title_ua : product.seo_title_ru) || name;
const seoDescription =
  (lang === 'ua' ? product.seo_description_ua : product.seo_description_ru) || shortDesc || undefined;

const images = product.images?.length ? product.images : [];
const path = `/product/${product.slug}`;
---

<BaseLayout lang={lang} path={path} title={seoTitle} description={seoDescription}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name,
    description: shortDesc || description || undefined,
    image: images.length ? images : undefined,
    offers: {
      '@type': 'Offer',
      priceCurrency: 'UAH',
      price: product.effectivePrice,
      availability: product.in_stock
        ? 'https://schema.org/InStock'
        : 'https://schema.org/OutOfStock',
    },
  })} />

  <section class="container product">
    <div class="gallery">
      {
        images.length ? (
          <>
            <div class="gallery-main">
              <img id="gallery-main-img" src={images[0]} alt={name} />
            </div>
            {images.length > 1 && (
              <div class="gallery-thumbs">
                {images.map((src) => (
                  <button type="button" class="thumb-btn" data-src={src}>
                    <img src={src} alt="" />
                  </button>
                ))}
              </div>
            )}
          </>
        ) : (
          <div class="gallery-main gallery-placeholder" aria-hidden="true">🌿</div>
        )
      }
    </div>

    <div class="info">
      <h1>{name}</h1>

      <div class="badges">
        {!product.in_stock && <span class="badge badge-out">{dict.common.outOfStock}</span>}
        {product.in_stock && product.isOnSale && <span class="badge badge-sale">{dict.common.sale}</span>}
      </div>

      {shortDesc && <p class="short-desc">{shortDesc}</p>}

      <div class="price-row">
        {
          product.isOnSale ? (
            <>
              <span class="price-old">{formatPrice(Number(product.price), lang)}</span>
              <span class="price-sale">{formatPrice(product.effectivePrice, lang)}</span>
            </>
          ) : (
            <span class="price">{formatPrice(product.effectivePrice, lang)}</span>
          )
        }
      </div>

      <div class="add-to-cart-row">
        <label class="qty-label">
          {dict.common.quantity}
          <input id="qty-input" type="number" min="1" max={product.stock} value="1" />
        </label>
        <button
          id="add-to-cart-btn"
          type="button"
          class="btn"
          disabled={!product.in_stock}
          data-product-id={product.id}
          data-slug={product.slug}
          data-name-ua={product.name_ua}
          data-name-ru={product.name_ru}
          data-image={images[0] ?? ''}
          data-price={product.effectivePrice}
          data-stock={product.stock}
        >
          {product.in_stock ? dict.common.addToCart : dict.common.outOfStock}
        </button>
      </div>

      {
        description && (
          <div class="long-desc">
            {description.split(/\n{2,}/).map((para) => (
              <p>{para}</p>
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .product {
    padding-block: 40px 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }

  .gallery-main {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-accent-soft);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gallery-main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-placeholder {
    font-size: 64px;
  }

  .gallery-thumbs {
    display: flex;
    gap: 8px;
    margin-top: 10px;
  }

  .thumb-btn {
    width: 64px;
    height: 64px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    padding: 0;
    background: none;
  }

  .thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .info h1 {
    margin-bottom: 10px;
  }

  .badges {
    display: flex;
    gap: 8px;
    margin-bottom: 12px;
  }

  .short-desc {
    color: var(--color-text-muted);
    margin-bottom: 20px;
  }

  .price-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 20px;
  }

  .price,
  .price-sale {
    font-size: 26px;
    font-weight: 700;
  }

  .price-sale {
    color: var(--color-sale);
  }

  .price-old {
    font-size: 16px;
    color: var(--color-text-muted);
    text-decoration: line-through;
  }

  .add-to-cart-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 32px;
  }

  .qty-label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .qty-label input {
    width: 70px;
    padding: 8px 10px;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    font-size: 15px;
  }

  .long-desc {
    border-top: 1px solid var(--color-border);
    padding-top: 24px;
    color: var(--color-text);
    line-height: 1.7;
  }

  @media (max-width: 780px) {
    .product {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>

<script>
  import { addToCart } from '@/lib/cart';

  const mainImg = document.getElementById('gallery-main-img') as HTMLImageElement | null;
  document.querySelectorAll<HTMLButtonElement>('.thumb-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.dataset.src;
      if (src && mainImg) mainImg.src = src;
    });
  });

  const addBtn = document.getElementById('add-to-cart-btn') as HTMLButtonElement | null;
  const qtyInput = document.getElementById('qty-input') as HTMLInputElement | null;

  addBtn?.addEventListener('click', () => {
    const stock = Math.max(0, Number(addBtn.dataset.stock) || 0);
    const qty = Math.min(Math.max(1, Number(qtyInput?.value) || 1), stock || 1);
    if (qtyInput) qtyInput.value = String(qty);
    addToCart(
      {
        productId: addBtn.dataset.productId!,
        slug: addBtn.dataset.slug!,
        nameUa: addBtn.dataset.nameUa!,
        nameRu: addBtn.dataset.nameRu!,
        image: addBtn.dataset.image || null,
        unitPrice: Number(addBtn.dataset.price),
        stock,
      },
      qty
    );
  });
</script>
