---
import { getDictionary, localizedPath, type Locale } from '@/i18n/config';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = getDictionary(lang);
const h = dict.home;
---

<section class="hero">
  <div class="hero-banner">
    <img src="/hero-banner.jpg" alt="" loading="eager" />
    <div class="hero-scrim" aria-hidden="true"></div>

    <div class="hero-overlay container">
      <span class="eyebrow">{h.eyebrow}</span>
      <h1>
        <span class="brand-script">AromaAnna</span>
        <span class="brand-tagline">Aesthetic Aromatherapy</span>
      </h1>
      <p>{h.heroSubtitle}</p>
      <div class="hero-actions">
        <a class="btn cta-organic" href={localizedPath(lang, '/catalog')}>
          <span class="cta-label">{h.shopNow}</span>
          <svg class="cta-fx" viewBox="0 0 180 100" preserveAspectRatio="none" aria-hidden="true">
            <path class="cta-wisp" d="M92,6 C86,18 98,24 92,36 C86,46 94,52 90,60" />
            <path
              class="cta-circle"
              d="M 12,26 C -4,46 4,70 28,74 C 70,82 150,78 168,58 C 180,44 168,22 138,20 C 90,16 20,22 12,42"
            />
            <circle class="cta-ember" r="3.5" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--color-bg);
  }

  .hero-banner {
    position: relative;
    overflow: hidden;
    min-height: 640px;
    width: 100vw;
    margin-left: calc(50% - 50vw);
  }

  .hero-banner img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    animation: hero-kenburns 22s ease-in-out infinite alternate;
  }

  @keyframes hero-kenburns {
    0% {
      transform: scale(1) translate(0, 0);
    }
    100% {
      transform: scale(1.08) translate(-1%, -1%);
    }
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(22, 17, 10, 0.68) 0%,
      rgba(22, 17, 10, 0.48) 38%,
      rgba(22, 17, 10, 0.22) 62%,
      rgba(22, 17, 10, 0.05) 82%,
      rgba(22, 17, 10, 0) 94%
    );
  }

  .hero-overlay {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 640px;
  }

  .eyebrow,
  .hero-overlay h1,
  .hero-overlay p,
  .hero-actions {
    opacity: 0;
    animation: hero-fade-up 0.9s ease forwards;
  }

  .eyebrow {
    animation-delay: 0.1s;
  }

  .hero-overlay h1 {
    animation-delay: 0.28s;
  }

  .hero-overlay p {
    animation-delay: 0.46s;
  }

  .hero-actions {
    animation-delay: 0.64s;
  }

  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: 16px;
    max-width: 420px;
  }

  .eyebrow::before {
    content: '';
    width: 20px;
    height: 1px;
    background: rgba(255, 255, 255, 0.6);
  }

  .hero-overlay h1 {
    margin: 0 0 18px;
    max-width: 460px;
  }

  .brand-script {
    display: block;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 46px;
    letter-spacing: -0.01em;
    line-height: 1.1;
    color: #fff;
  }

  .brand-tagline {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.24em;
    font-size: 11px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.85);
    margin-top: 12px;
  }

  .brand-tagline::before,
  .brand-tagline::after {
    content: '';
    width: 14px;
    height: 1px;
    background: rgba(255, 255, 255, 0.5);
  }

  .hero-overlay p {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
    font-size: 21px;
    line-height: 1.6;
    max-width: 440px;
    margin-bottom: 26px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .hero-actions .btn {
    position: relative;
    color: #fff;
    padding: 10px 6px;
    transition: color 0.2s ease;
  }

  .hero-actions .btn::after {
    content: none;
  }

  .hero-actions .btn:hover {
    color: rgba(255, 255, 255, 0.75);
  }

  .hero-actions .cta-label {
    position: relative;
    z-index: 1;
    display: inline-block;
    animation: hero-text-arrive 5s ease-in-out infinite;
  }

  .hero-actions .cta-fx {
    position: absolute;
    inset: -34px -30px -20px;
    width: calc(100% + 60px);
    height: calc(100% + 54px);
    overflow: visible;
    pointer-events: none;
  }

  .hero-actions .cta-wisp {
    fill: none;
    stroke: #f2e3ab;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 40;
    stroke-dashoffset: 40;
    filter: blur(1.2px);
    animation: hero-wisp-up 5s ease-in-out infinite;
  }

  .hero-actions .cta-circle {
    fill: none;
    stroke: #f6ead0;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 340;
    stroke-dashoffset: 340;
    filter: drop-shadow(0 0 3px rgba(242, 227, 171, 0.5));
    animation: hero-circle-draw 5s ease-in-out infinite;
  }

  .hero-actions .cta-ember {
    fill: #f2c85b;
    filter: drop-shadow(0 0 4px rgba(242, 200, 91, 0.9));
    offset-path: path(
      'M 12,26 C -4,46 4,70 28,74 C 70,82 150,78 168,58 C 180,44 168,22 138,20 C 90,16 20,22 12,42'
    );
    animation: hero-ember-travel 5s ease-in-out infinite;
    opacity: 0;
  }

  @keyframes hero-wisp-up {
    0% {
      stroke-dashoffset: 40;
      opacity: 0;
    }
    10% {
      opacity: 0.85;
    }
    38% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes hero-circle-draw {
    0% {
      stroke-dashoffset: 340;
      opacity: 0;
    }
    38% {
      stroke-dashoffset: 340;
      opacity: 1;
    }
    68% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      stroke-dashoffset: 0;
    }
  }

  @keyframes hero-ember-travel {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }
    38% {
      offset-distance: 0%;
      opacity: 0;
    }
    40% {
      opacity: 1;
    }
    68% {
      offset-distance: 100%;
      opacity: 1;
    }
    74% {
      opacity: 0;
    }
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }

  @keyframes hero-text-arrive {
    0% {
      opacity: 0.85;
      transform: translateY(0);
      letter-spacing: 0.1em;
    }
    38% {
      opacity: 0.85;
      transform: translateY(0);
      letter-spacing: 0.1em;
    }
    60% {
      opacity: 1;
      transform: translateY(-2px);
      letter-spacing: 0.16em;
    }
    100% {
      opacity: 1;
      transform: translateY(0);
      letter-spacing: 0.1em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-actions .cta-wisp,
    .hero-actions .cta-ember {
      display: none;
    }

    .hero-actions .cta-circle {
      animation: none;
      stroke-dashoffset: 0;
      opacity: 0.7;
    }

    .hero-actions .cta-label {
      animation: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-banner img {
      animation: none;
    }

    .eyebrow,
    .hero-overlay h1,
    .hero-overlay p,
    .hero-actions {
      opacity: 1;
      animation: none;
      transform: none;
    }
  }

  @media (max-width: 720px) {
    .hero-banner,
    .hero-overlay {
      min-height: 620px;
    }

    .hero-scrim {
      background: linear-gradient(
        180deg,
        rgba(22, 17, 10, 0.05) 0%,
        rgba(22, 17, 10, 0.42) 48%,
        rgba(22, 17, 10, 0.58) 72%
      );
    }

    .hero-overlay {
      justify-content: flex-end;
      text-align: center;
      padding-bottom: 40px;
    }

    .eyebrow {
      justify-content: center;
      max-width: none;
    }

    .hero-overlay h1 {
      max-width: none;
    }

    .brand-script {
      font-size: 34px;
    }

    .hero-overlay p {
      font-size: 18px;
      line-height: 1.6;
      max-width: none;
      margin-inline: auto;
    }

    .hero-actions {
      justify-content: center;
    }
  }
</style>
