---
import { getDictionary, localizedPath, type Locale } from '@/i18n/config';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = getDictionary(lang);
const h = dict.home;

const kicker = lang === 'ua' ? 'АРОМАТ У ДЕТАЛЯХ' : 'АРОМАТ В ДЕТАЛЯХ';

const cases = [
  {
    img: '/images/use-cases/bedroom.jpeg',
    ua: 'Спальня',
    ru: 'Спальня',
    captionUa: 'затишний ранок і тихий вечір',
    captionRu: 'уютное утро и тихий вечер',
  },
  {
    img: '/images/use-cases/tea-ceremony.jpeg',
    ua: 'Чайна церемонія',
    ru: 'Чайная церемония',
    captionUa: 'ритуал сповільнення',
    captionRu: 'ритуал замедления',
  },
  {
    img: '/images/use-cases/study.jpeg',
    ua: 'Кабінет',
    ru: 'Кабинет',
    captionUa: 'концентрація без поспіху',
    captionRu: 'концентрация без спешки',
  },
  {
    img: '/images/use-cases/spa.jpeg',
    ua: 'Спа-ритуал',
    ru: 'Спа-ритуал',
    captionUa: 'ванна як маленький ритуал',
    captionRu: 'ванна как маленький ритуал',
  },
  {
    img: '/images/use-cases/yoga.jpeg',
    ua: 'Йога',
    ru: 'Йога',
    captionUa: 'глибокий подих, ясний розум',
    captionRu: 'глубокое дыхание, ясный ум',
  },
  {
    img: '/images/use-cases/tea-room.jpeg',
    ua: 'Чайна кімната',
    ru: 'Чайная комната',
    captionUa: 'тепла розмова за чаєм',
    captionRu: 'тёплый разговор за чаем',
  },
  {
    img: '/images/use-cases/meditation.jpeg',
    ua: 'Медитація',
    ru: 'Медитация',
    captionUa: 'момент тиші всередині',
    captionRu: 'момент тишины внутри',
  },
  {
    img: '/images/use-cases/office.jpeg',
    ua: 'Офіс',
    ru: 'Офис',
    captionUa: 'спокій серед справ',
    captionRu: 'спокойствие среди дел',
  },
  {
    img: '/images/use-cases/reading.jpeg',
    ua: 'Читання',
    ru: 'Чтение',
    captionUa: 'аромат для книги й тиші',
    captionRu: 'аромат для книги и тишины',
  },
] as const;
---

<section class="use-cases">
  <div class="container">
    <div class="heading">
      <span class="eyebrow">
        <span class="line"></span>
        {kicker}
        <span class="line"></span>
      </span>
      <h2>{h.useCasesHeading}</h2>
      <p>{h.useCasesSubtitle}</p>
    </div>
  </div>

  <div class="carousel">
    <button class="car-btn car-prev" type="button" aria-label="Previous">‹</button>

    <div class="swiper use-cases-swiper">
      <div class="swiper-wrapper">
        {
          cases.map((c) => (
            <a href={localizedPath(lang, '/catalog')} class="case-card swiper-slide">
              <img src={c.img} alt={lang === 'ua' ? c.ua : c.ru} loading="lazy" decoding="async" />
              <span class="case-overlay" aria-hidden="true" />
              <span class="case-text">
                <span class="case-label">{lang === 'ua' ? c.ua : c.ru}</span>
                <span class="case-caption">{lang === 'ua' ? c.captionUa : c.captionRu}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <button class="car-btn car-next" type="button" aria-label="Next">›</button>
  </div>

  <div class="container">
    <div class="car-dots"></div>

    <p class="use-cases-outro">
      {lang === 'ua'
        ? 'Кожен простір заслуговує на свій аромат'
        : 'Каждое пространство заслуживает свой аромат'}
    </p>
  </div>
</section>

<style>
  .use-cases {
    background: var(--color-bg);
    padding-block: 52px 72px;
  }

  .heading {
    text-align: center;
    margin-bottom: 36px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-dark);
    margin-bottom: 16px;
  }

  .line {
    width: 28px;
    height: 1px;
    background: var(--color-accent-dark);
    opacity: 0.5;
  }

  .heading h2 {
    font-size: 26px;
    margin: 0 0 8px;
  }

  .heading p {
    color: var(--color-text-muted);
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 17px;
    margin: 0;
  }

  /* full-bleed carousel — escapes the .container so it can use the whole viewport width */
  .carousel {
    --gutter: max(20px, calc((100vw - 1160px) / 2 + 20px));
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
  }

  .use-cases-swiper {
    padding: 4px var(--gutter) 18px;
  }

  :global(.use-cases-swiper .swiper-wrapper) {
    align-items: stretch;
  }

  .case-card {
    position: relative;
    display: block;
    width: 320px;
    aspect-ratio: 4 / 5;
    border-radius: 18px;
    overflow: hidden;
    background: var(--color-accent-soft);
    text-decoration: none;
    opacity: 0.55;
    transform: scale(0.93);
    transition: transform 0.4s ease, opacity 0.4s ease;
  }

  :global(.case-card.swiper-slide-active) {
    opacity: 1;
    transform: scale(1);
  }

  .case-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .case-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(30, 22, 14, 0.8) 0%, rgba(30, 22, 14, 0.18) 45%, rgba(30, 22, 14, 0) 70%);
    transition: background 0.3s ease;
  }

  .case-text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 18px 18px 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .case-label {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 600;
    color: #fff;
    letter-spacing: 0.01em;
  }

  .case-caption {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.85);
  }

  .case-card:hover img {
    transform: scale(1.06);
  }

  .case-card:hover .case-overlay {
    background: linear-gradient(to top, rgba(30, 22, 14, 0.85) 0%, rgba(30, 22, 14, 0.28) 50%, rgba(30, 22, 14, 0) 75%);
  }

  .car-btn {
    position: absolute;
    top: 46%;
    transform: translateY(-50%);
    z-index: 5;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: rgba(255, 255, 255, 0.92);
    box-shadow: var(--shadow-sm, 0 2px 10px rgba(30, 22, 14, 0.1));
    color: var(--color-text);
    font-size: 20px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .car-prev {
    left: var(--gutter);
    transform: translate(-50%, -50%);
  }

  .car-next {
    right: var(--gutter);
    transform: translate(50%, -50%);
  }

  .car-btn:hover {
    background: var(--color-accent-dark);
    border-color: var(--color-accent-dark);
    color: #fff;
  }

  .car-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
  }

  :global(.car-dots .dot) {
    width: 7px;
    height: 7px;
    padding: 0;
    border-radius: 50%;
    border: none;
    background: var(--color-border);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  :global(.car-dots .dot.active) {
    background: var(--color-accent-dark);
    transform: scale(1.35);
  }

  .use-cases-outro {
    text-align: center;
    margin: 26px 0 0;
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 19px;
    color: var(--color-text-muted);
  }

  @media (max-width: 720px) {
    .case-card {
      width: 230px;
    }
    .case-label {
      font-size: 15px;
    }
    .case-caption {
      font-size: 12px;
    }
    .car-btn {
      display: none;
    }
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Autoplay } from 'swiper/modules';
  import 'swiper/css';

  const carousel = document.querySelector<HTMLElement>('.carousel');
  const swiperEl = carousel?.querySelector<HTMLElement>('.use-cases-swiper');
  const prevBtn = carousel?.querySelector<HTMLButtonElement>('.car-prev');
  const nextBtn = carousel?.querySelector<HTMLButtonElement>('.car-next');
  const dotsWrap = document.querySelector<HTMLElement>('.car-dots');

  if (swiperEl) {
    const slideCount = swiperEl.querySelectorAll('.swiper-slide').length;

    // Власні крапки-індикатори (замінюють стандартну пагінацію Swiper,
    // щоб зберегти той самий вигляд .dot/.dot.active, що й раніше).
    if (dotsWrap) {
      dotsWrap.innerHTML = '';
      for (let i = 0; i < slideCount; i++) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'dot';
        dot.setAttribute('aria-label', `Slide ${i + 1}`);
        dotsWrap.appendChild(dot);
      }
    }
    const dots = dotsWrap ? Array.from(dotsWrap.children) as HTMLButtonElement[] : [];

    const swiper = new Swiper(swiperEl, {
      modules: [Autoplay],
      slidesPerView: 'auto',
      spaceBetween: 20,
      centeredSlides: true,
      loop: slideCount > 2,
      autoplay: {
        delay: 4200,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      },
      on: {
        slideChange(sw) {
          const real = sw.realIndex ?? sw.activeIndex;
          dots.forEach((d, i) => d.classList.toggle('active', i === real));
        },
      },
    });

    dots.forEach((d, i) => {
      d.addEventListener('click', () => swiper.slideToLoop(i));
    });

    if (prevBtn) prevBtn.addEventListener('click', () => swiper.slidePrev());
    if (nextBtn) nextBtn.addEventListener('click', () => swiper.slideNext());
  }
</script>
