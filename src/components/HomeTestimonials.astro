---
import { getDictionary, type Locale } from '@/i18n/config';
import { fetchPublishedTestimonials } from '@/lib/testimonials';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = getDictionary(lang);
const h = dict.home;

const testimonials = (await fetchPublishedTestimonials()).slice(0, 4);
---

{
  testimonials.length > 0 && (
    <section class="testimonials">
      <div class="container">
        <span class="eyebrow">
          <span class="line" />
          {h.testimonialsHeading} <span aria-hidden="true">💛</span>
          <span class="line" />
        </span>

        <div class="grid">
          {testimonials.map((t) => {
            const text = lang === 'ua' ? t.text_ua : t.text_ru || t.text_ua;
            const rating = Math.max(0, Math.min(5, Number(t.rating) || 5));
            return (
              <figure class="t-card">
                <div class="t-stars" aria-hidden="true">
                  {'★'.repeat(rating)}
                  {'☆'.repeat(5 - rating)}
                </div>
                <blockquote class="t-text">«{text}»</blockquote>
                <figcaption class="t-author">{t.author_name}</figcaption>
              </figure>
            );
          })}
        </div>
      </div>
    </section>
  )
}

<style>
  .testimonials {
    background: var(--color-bg);
    padding-block: 20px 56px;
  }

  .eyebrow {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-dark);
    margin-bottom: 26px;
  }

  .line {
    width: 28px;
    height: 1px;
    background: var(--color-accent-dark);
    opacity: 0.5;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }

  .t-card {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 22px 20px;
  }

  .t-stars {
    color: var(--color-ember, #f2e3ab);
    font-size: 14px;
    letter-spacing: 2px;
  }

  .t-text {
    margin: 0;
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-text);
  }

  .t-author {
    margin-top: auto;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
