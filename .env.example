# Публічні (безпечно в браузері) — використовуються фронтендом
PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Netlify build hook — кнопка "Опублікувати зміни" в адмінці. Створюється в
# Netlify Dashboard → Site settings → Build & deploy → Build hooks.
PUBLIC_NETLIFY_BUILD_HOOK_URL=https://api.netlify.com/build_hooks/xxxxxxxx

# Секретні — ТІЛЬКИ для Netlify Functions (netlify/functions), задаються
# в Netlify Dashboard → Site settings → Environment variables.
# Ніколи не додавай їх у код, що йде у браузер, і не комітиш реальні значення.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
TELEGRAM_BOT_TOKEN=xxxxxxxx
TELEGRAM_CHAT_ID=xxxxxxxx
